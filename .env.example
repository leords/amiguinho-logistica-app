# Amiguinho Logística Mobile - Configurações de Ambiente (Expo)

# 1. API Principal (Carga de pedidos, baixa comercial e atualização de cadastro de clientes)
EXPO_PUBLIC_API_PRINCIPAL_URL=http://localhost:4000
#https://api.amigaodistribuidora.com.br

#http://localhost:4000

# 2. API de Logística (Abertura/fechamento de jornadas, telemetria GPS e eventos operacionais)
# Em emulador Android local: http://10.0.2.2:3334
# Em dispositivo físico na rede local: http://<IP_DO_SEU_PC>:3334
# Em produção: https://logistica-api.amigaodistribuidora.com.br
EXPO_PUBLIC_API_LOGISTICA_URL=http://10.0.2.2:3334
